# Configurazione per il frontend Trascendence

# Scegli una delle due modalità di connessione:

# MODALITÀ 1: API Gateway (raccomandata)
VITE_API_MODE=gateway
VITE_API_URL=https://localhost:8090/api

# MODALITÀ 2: Connessione Diretta ai Microservizi (development)
# VITE_API_MODE=direct
# VITE_USER_SERVICE_URL=http://localhost:3001
# VITE_GAME_SERVICE_URL=http://localhost:3002
# VITE_CHAT_SERVICE_URL=http://localhost:3003
# VITE_BLOCKCHAIN_SERVICE_URL=http://localhost:3004

# Altre configurazioni
VITE_WS_URL=ws://localhost:4001
