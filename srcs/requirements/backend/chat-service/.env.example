# ==========================================
# Chat Service Configuration
# ==========================================

# Server Configuration
PORT=3002
HOST=localhost
LOG_LEVEL=info

# ==========================================
# JWT Configuration
# IMPORTANTE: Deve essere IDENTICO a quello dello user-service!
# ==========================================
JWT_SECRET=supersecret

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGIN=http://localhost:5173

# ==========================================
# Database Configuration
# ==========================================
DATABASE_PATH=./data/chat.db

# ==========================================
# External Services
# ==========================================
USER_SERVICE_URL=http://localhost:3001
GAME_SERVICE_URL=http://localhost:3003
TOURNAMENT_SERVICE_URL=http://localhost:3004

# ==========================================
# Chat Settings (Optional)
# ==========================================
# Numero massimo di messaggi da restituire per richiesta
MAX_MESSAGES_PER_REQUEST=100

# Tempo di scadenza inviti in minuti
INVITATION_EXPIRY_MINUTES=10

# Timeout inattività presenza in minuti
PRESENCE_TIMEOUT_MINUTES=5

# ==========================================
# WebSocket Settings (Optional)
# ==========================================
# Dimensione massima payload WebSocket in bytes
WS_MAX_PAYLOAD=1048576

# ==========================================
# Development/Production
# ==========================================
NODE_ENV=development

