# Server Configuration
HOST=localhost
PORT=3001
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=https://localhost:8090

# JWT Configuration
JWT_SECRET=supersecret

# Google OAuth2 Configuration
# Ottieni le credenziali da: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_IDMASTAIIM=la-tua-client
GOOGLE_CLIENT_SECRET=la-tua-secret
GOOGLE_CALLBACK_URL=https://localhost:8090/api/auth/google/callback

# Backend URL (usato per il callback OAuth)
BACKEND_URL=https://localhost:8090

# Frontend URL (usato per redirect dopo OAuth)
FRONTEND_URL=https://localhost:8090
