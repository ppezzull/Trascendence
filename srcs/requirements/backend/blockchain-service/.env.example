# ==========================================
# Blockchain Service Configuration - Smart Contract Development
# ==========================================

# ==========================================
# RPC Endpoints for Different Networks
# ==========================================

# Local Development (Anvil/Hardhat)
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
CHAIN_ID=31337

# Avalanche Fuji Testnet (uncomment for testnet deployment)
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# FUJI_PRIVATE_KEY=your_fuji_testnet_private_key_here
# FUJI_CONTRACT_ADDRESS=your_deployed_contract_address_on_fuji
# CHAIN_ID=43113

# Avalanche Mainnet (uncomment for production deployment)
# MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# MAINNET_PRIVATE_KEY=your_mainnet_private_key_here
# MAINNET_CONTRACT_ADDRESS=your_deployed_contract_address_on_mainnet
# CHAIN_ID=43114

# ==========================================
# Contract Deployment Configuration
# ==========================================

# Default contract to deploy (matches foundry.toml [deploy] section)
DEPLOY_CONTRACT=TournamentScores

# Gas configuration (optional)
# GAS_LIMIT=3000000
# GAS_PRICE=225000000000

# ==========================================
# Development Environment
# ==========================================
NODE_ENV=development

# ==========================================
# Foundry Configuration References
# ==========================================

# RPC endpoints configured in foundry.toml:
# [rpc_endpoints]
# local = "http://127.0.0.1:8545"
# fuji = "https://api.avax-test.network/ext/bc/C/rpc"
# mainnet = "https://api.avax.network/ext/bc/C/rpc"

# ==========================================
# Common Deployment Commands
# ==========================================

# Deploy to local Anvil:
# forge script script/Deploy.s.sol:Deploy --rpc-url $RPC_URL --private-key $PRIVATE_KEY --broadcast

# Deploy to Fuji Testnet:
# forge script script/Deploy.s.sol:Deploy --rpc-url $FUJI_RPC_URL --private-key $FUJI_PRIVATE_KEY --broadcast

# Deploy to Mainnet:
# forge script script/Deploy.s.sol:Deploy --rpc-url $MAINNET_RPC_URL --private-key $MAINNET_PRIVATE_KEY --broadcast

# ==========================================
# Security Notes
# ==========================================
# 1. NEVER commit actual private keys to version control
# 2. Use different keys for development, testnet, and mainnet
# 3. Keep private keys secure and use hardware wallets for mainnet
# 4. Contract addresses will be generated after deployment
# 5. Update CONTRACT_ADDRESS after successful deployment
# ==========================================