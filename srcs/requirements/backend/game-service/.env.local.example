# Game Service - Local Development Configuration
# Copy this to .env for local development with Anvil

# Server Configuration
PORT=3003
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development

# JWT Configuration
JWT_SECRET=supersecret

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Configuration
DATABASE_PATH=./data/games.db
DATABASE_URL=./data/games.db

# External Services
USER_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URL=http://localhost:3002

# Local Blockchain Configuration
# Anvil must be running: anvil
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
TOURNAMENT_SCORES_CONTRACT_ADDRESS=YOUR_DEPLOYED_CONTRACT_ADDRESS_HERE
CHAIN_ID=31337

# Tournament Settings
DEFAULT_ELO_RANGE=200
MATCHMAKING_TIMEOUT_MINUTES=30

# Development Settings
DEBUG_MODE=true
ENABLE_BLOCKCHAIN_HEALTH_CHECK=true
SERVICE_NAME=game-service

# Local Setup Commands
# 1. Start Anvil: anvil
# 2. Deploy contract:
#    cd ../blockchain-service
#    forge script script/Deploy.s.sol:Deploy \
#      --rpc-url http://127.0.0.1:8545 \
#      --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 \
#      --broadcast
# 3. Copy contract address from output to TOURNAMENT_SCORES_CONTRACT_ADDRESS
# 4. Set JWT_SECRET to match user-service
# 5. Run: npm install && npm run build && npm run dev

# Test Commands
# curl http://localhost:3003/api/blockchain/health
# curl -X POST http://localhost:3003/api/tournaments \
#   -H "Content-Type: application/json" \
#   -H "Authorization: Bearer YOUR_JWT" \
#   -d '{"name": "Local Test", "game_id": 1, "max_players": 4, "tournament_type": "single_elimination"}'