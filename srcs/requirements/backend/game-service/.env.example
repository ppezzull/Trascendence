# Game Service Configuration - Blockchain-First Tournament System
# Copy this to .env and configure for your environment

# Server Configuration
PORT=3003
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development

# JWT Configuration
# Must be identical to user-service JWT secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Configuration
DATABASE_PATH=./data/games.db
DATABASE_URL=./data/games.db

# External Services
USER_SERVICE_URL=http://localhost:3001
CHAT_SERVICE_URL=http://localhost:3002

# Blockchain Configuration (Primary Score Storage)
# CHOOSE ONE SECTION BELOW:

# Local Development (Default)
# Start Anvil first: anvil
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
TOURNAMENT_SCORES_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
CHAIN_ID=31337

# Production Environment
# Uncomment these lines for production
# BLOCKCHAIN_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# BLOCKCHAIN_PRIVATE_KEY=your_production_private_key_here
# TOURNAMENT_SCORES_CONTRACT_ADDRESS=your_production_contract_address_here
# CHAIN_ID=43114

# Tournament Settings
DEFAULT_ELO_RANGE=200
MATCHMAKING_TIMEOUT_MINUTES=30

# Development Settings
DEBUG_MODE=false
ENABLE_BLOCKCHAIN_HEALTH_CHECK=true
SERVICE_NAME=game-service

# Setup Requirements
# Local Development:
# 1. Run: anvil
# 2. Deploy contract locally
# 3. Update contract address above
# 4. Set JWT_SECRET to match user-service

# Production:
# 1. Have production AVAX tokens
# 2. Secure private key storage
# 3. Contract deployed to mainnet
# 4. HTTPS and security configured

# Security Notes
# 1. NEVER commit actual private keys to version control
# 2. Use different private keys for each environment
# 3. Change JWT_SECRET for production
# 4. Use HTTPS in production
# 5. Tournament scores are stored IMMUTABLY on blockchain
# 6. Database stores only metadata, not scores

# Quick Test Commands
# Test blockchain: curl http://localhost:3003/api/blockchain/health

# Create tournament:
# curl -X POST http://localhost:3003/api/tournaments \
#   -H "Content-Type: application/json" \
#   -H "Authorization: Bearer YOUR_JWT" \
#   -d '{"name": "Test Tournament", "game_id": 1, "max_players": 4, "tournament_type": "single_elimination"}'

# Run Service
# npm install
# npm run build
# npm run dev

# Available at:
# API: http://localhost:3003
# Swagger: http://localhost:3003/docs
# Health: http://localhost:3003/health