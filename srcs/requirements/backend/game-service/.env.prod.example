# Game Service - Production Configuration
# Copy this to .env for production deployment

# Server Configuration
PORT=3003
HOST=localhost
LOG_LEVEL=warn
NODE_ENV=production

# JWT Configuration
# Must be identical to user-service JWT secret
JWT_SECRET=your-production-jwt-secret-here

# CORS Configuration
# Update with your production frontend URL
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Configuration
DATABASE_PATH=./data/games.db
DATABASE_URL=./data/games.db

# External Services
# Update with your production service URLs
USER_SERVICE_URL=https://your-user-service-url.com
CHAT_SERVICE_URL=https://your-chat-service-url.com

# Production Blockchain Configuration
# Uncomment and configure for production
BLOCKCHAIN_RPC_URL=https://api.avax.network/ext/bc/C/rpc
BLOCKCHAIN_PRIVATE_KEY=your_production_private_key_here
TOURNAMENT_SCORES_CONTRACT_ADDRESS=your_production_contract_address_here
CHAIN_ID=43114

# Tournament Settings
DEFAULT_ELO_RANGE=200
MATCHMAKING_TIMEOUT_MINUTES=30

# Production Settings
DEBUG_MODE=false
ENABLE_BLOCKCHAIN_HEALTH_CHECK=true
SERVICE_NAME=game-service

# Production Requirements
# 1. Have production AVAX tokens
# 2. Secure private key storage (hardware wallet recommended)
# 3. Contract deployed to Avalanche mainnet
# 4. HTTPS and security configured
# 5. Load balancer and monitoring setup
# 6. Backup and recovery procedures
# 7. Security audit completed

# Security Notes
# 1. NEVER commit actual private keys to version control
# 2. Use secure key management system
# 3. Enable HTTPS only
# 4. Set up monitoring and alerting
# 5. Regular security updates
# 6. Database backups configured

# Production Test Commands
# Test connectivity: curl https://your-domain.com/api/blockchain/health
# Test load: Use load testing tools
# Monitor: Set up application monitoring