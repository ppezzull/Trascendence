# ==============================================================================
# Trascendence Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it should be in .gitignore)
# ==============================================================================

# ==============================================================================
# JWT Configuration
# ==============================================================================
# Secret key for JWT token signing (CHANGE THIS!)
JWT_SECRET=supersecret

# ==============================================================================
# Google OAuth Configuration
# ==============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8090/api/auth/google/callback

# ==============================================================================
# Grafana Monitoring Configuration (Module #42)
# ==============================================================================
# MANDATORY: Strong password for Grafana admin user
# Requirements:
#   - Minimum 12 characters
#   - Mix of uppercase, lowercase, numbers, and special characters
#   - NOT a dictionary word or common password
# Generate strong password: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=Transcendence_Admin_2025!

# ==============================================================================
# Avalanche Fuji Blockchain Configuration (for game-service)
# ==============================================================================
# RPC URL for Avalanche Fuji testnet
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployed TournamentScores smart contract address
# Deploy the contract first from backend/blockchain-service
CONTRACT_ADDRESS=0xYourContractAddressHere

# Private key for blockchain transactions (NO 0x prefix)
# SECURITY WARNING: Never commit this to Git!
# Get test AVAX from: https://faucet.avax.network/
PRIVATE_KEY=your-private-key-here-without-0x-prefix

# ==============================================================================
# NOTES
# ==============================================================================
#
# JWT_SECRET:
#   - Generate a strong random string: openssl rand -base64 32
#   - Must be at least 32 characters long
#   - Same secret must be used across all services (user, game, chat)
#
# Google OAuth:
#   - Create OAuth 2.0 credentials in Google Cloud Console
#   - Add authorized redirect URI: https://localhost:8090/api/auth/google/callback
#   - Enable Google+ API if required
#
# Grafana (Module #42):
#   - GRAFANA_ADMIN_PASSWORD: Admin password for Grafana monitoring dashboard
#   - Generate strong password: openssl rand -base64 24
#   - Minimum 12 characters required (enforced by password policy)
#   - Access Grafana at: https://localhost:8090/grafana/
#   - Username: admin
#
# Blockchain:
#   - CONTRACT_ADDRESS: Deploy TournamentScores.sol first
#     cd srcs/requirements/backend/blockchain-service
#     forge script script/Deploy.s.sol --rpc-url $FUJI_RPC_URL --broadcast
#   - PRIVATE_KEY: Export from MetaMask or create new wallet
#     NEVER share or commit this key!
#   - Get test AVAX: https://faucet.avax.network/
#
# ==============================================================================

KIBANA_ADMIN_PASSWORD=Transcendence_Kibana_2025!